# Goldseam Repository Git Attributes
# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf
Dockerfile* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.whl binary
*.pyc binary

# Linguist attributes for repository language statistics
benchmarks/golden_traces/* linguist-vendored
benchmarks/results/* linguist-generated
tests/fixtures/* linguist-vendored

# Security: prevent secret files from appearing in diffs if accidentally created
*.env -diff
*.env.* -diff
*.pem -diff
*.key -diff
*.cert -diff
*.crt -diff
*.p12 -diff
*.pfx -diff
*.pkcs12 -diff
*.kdbx -diff
*id_rsa* -diff
*id_ed25519* -diff
*credentials*.json -diff
*client_secret*.json -diff
*service-account*.json -diff
*token*.json -diff

# Archive export ignores
.github/ export-ignore
.gitleaks.toml export-ignore
.pre-commit-config.yaml export-ignore
.gitattributes export-ignore
.gitignore export-ignore
.git-blame-ignore-revs export-ignore
.gitmessage export-ignore
.tmp-audit/ export-ignore
tests/ export-ignore
benchmarks/ export-ignore
