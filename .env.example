# Goldseam Optional Environment Variables
# Copy this file to .env and configure local overrides.
# Never commit .env containing real credentials.

# --- Optional External LLM Provider API Keys ---
# Required only when running live synthesis without FakeLLM test adapters.
# OPENAI_API_KEY=sk-your-openai-api-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
# OLLAMA_BASE_URL=http://localhost:11434

# --- Goldseam Local Runtime Settings ---
# GOLDSEAM_HOME=~/.goldseam
# GOLDSEAM_LOG_LEVEL=INFO
# GOLDSEAM_SANDBOX_BACKEND=docker
# GOLDSEAM_ALLOW_WEAK_SANDBOX=false
